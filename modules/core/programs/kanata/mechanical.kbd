;; ┌──────────────────────────────────────────────────────────────┐
;; │                     MECHANICAL KEYBOARD CONFIG               │
;; │  Physical left Alt → acts as SUPER (lmet) for Hyprland       │
;; │  Physical left Win  → acts as ALT (lalt)                     │
;; └──────────────────────────────────────────────────────────────┘

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lalt lmet spc  ralt rmet rctl
)

(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt spc  ralt rmet rctl          ;; ← swapped here
)

(defalias
  ;; tap: esc, hold: toggle nav layer
  cap (tap-hold 80 100 esc (layer-toggle nav))
  
  ;; layer-switch to symbols (you were using it as alias but not in layers yet)
  symbol (layer-switch symbols)
)

(deflayer nav
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  C-q  C-w  C-e  C-r  C-t  C-y  C-u  C-i  C-o  C-p  [    ]    \
  lctl C-a  C-s  bspc C-bspc C-g  left down up   right ;    '    ret
  lsft C-z  C-x  C-c  C-v  C-b  S--  S-9  ,    .    /    rsft
  caps lmet (layer-toggle symbols) spc  ralt rmet rctl     ;; ← lmet here too
)

(deflayer symbols
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  C-q  C-w  C-e  C-r  C-t  C-y  C-u  C-i  C-o  C-p  [    ]    \
  _    C-a  C-s  bspc C-bspc C-g  S--  S-9  S-[  .    ;    '    ret
  lsft C-z  C-x  C-c  C-v  C-b  C-n  C-m  ,    .    /    rsft
  lctl _    lmet spc  ralt rmet rctl                   ;; ← lmet here too
)
